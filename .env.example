# Copy to .env (never commit it)
DB_PASSWORD=change-me
ROOT_PASSWORD=change-me
APP_KEY=change-me-long-random-string
# Optional multicore knobs
# MULTICORE_MAX_WORKERS=8        # upper bound shown/accepted by the switch (default min(cpus*2, 32))
# MULTICORE_QUICKSTART=0         # do not run `start --quickstart` on the first boot
# MULTICORE_EXIT_GRACE_MS=10000  # how long a worker may take to stop before process.exit
# MULTICORE_REDIS_PREFIX=mcore   # Redis key prefix
# MULTICORE_NAMESPACE=nocobase   # separate clusters sharing one Redis
